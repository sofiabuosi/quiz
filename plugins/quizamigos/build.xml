<?xml version="1.0" encoding="UTF-8"?>
<project name="pitiupi.quizamigos" default="jar" basedir=".">
    <description>Compila o plugin Quiz para o Pitiupi.</description>

    <property name="src.dir" value="src" />
    <property name="build.dir" value="build" />
    <property name="dist.dir" value="dist" />
    <property name="core.jar" location="../../pitiupi/dist/pitiupi.jar" />
    <property name="plugin.jar" value="${dist.dir}/pitiupi.quizamigos.jar" />
    <property name="test.src.dir" value="test" />
    <property name="test.build.dir" value="build-test" />

    <target name="check-core">
        <available file="${core.jar}" property="core.jar.exists" />
        <fail unless="core.jar.exists"
              message="JAR do núcleo não encontrado em ${core.jar}. Na raiz do repositório, execute primeiro: cd pitiupi; ant jar" />
    </target>

    <target name="clean">
        <delete dir="${build.dir}" />
        <delete dir="${dist.dir}" />
        <delete dir="${test.build.dir}" />
    </target>

    <target name="compile" depends="check-core">
        <mkdir dir="${build.dir}" />
        <javac srcdir="${src.dir}"
               destdir="${build.dir}"
               includeantruntime="false"
               source="17"
               target="17"
               encoding="UTF-8">
            <classpath>
                <pathelement location="${core.jar}" />
            </classpath>
        </javac>
        <copy todir="${build.dir}">
            <fileset dir="${src.dir}">
                <exclude name="**/*.java" />
            </fileset>
        </copy>
    </target>

    <target name="test" depends="compile">
        <mkdir dir="${test.build.dir}" />
        <javac srcdir="${test.src.dir}"
               destdir="${test.build.dir}"
               includeantruntime="false"
               source="17"
               target="17"
               encoding="UTF-8">
            <classpath>
                <pathelement location="${core.jar}" />
                <pathelement location="${build.dir}" />
            </classpath>
        </javac>
        <java classname="quizamigos.QuizMessageSerializationTest"
              fork="true" failonerror="true">
            <classpath>
                <pathelement location="${core.jar}" />
                <pathelement location="${build.dir}" />
                <pathelement location="${test.build.dir}" />
            </classpath>
        </java>
        <java classname="quizamigos.QuizStorePersistenceTest"
              fork="true" failonerror="true">
            <classpath>
                <pathelement location="${core.jar}" />
                <pathelement location="${build.dir}" />
                <pathelement location="${test.build.dir}" />
            </classpath>
        </java>
        <java classname="quizamigos.QuizCatalogTest"
              fork="true" failonerror="true">
            <classpath>
                <pathelement location="${core.jar}" />
                <pathelement location="${build.dir}" />
                <pathelement location="${test.build.dir}" />
            </classpath>
        </java>
        <java classname="quizamigos.MusicPlayerAudioTest"
              fork="true" failonerror="true">
            <classpath>
                <pathelement location="${core.jar}" />
                <pathelement location="${build.dir}" />
                <pathelement location="${test.build.dir}" />
            </classpath>
        </java>
        <java classname="quizamigos.QuizBehaviorRulesTest"
              fork="true" failonerror="true">
            <classpath>
                <pathelement location="${core.jar}" />
                <pathelement location="${build.dir}" />
                <pathelement location="${test.build.dir}" />
            </classpath>
        </java>
        <java classname="quizamigos.QuizNetworkProtocolTest"
              fork="true" failonerror="true">
            <classpath>
                <pathelement location="${core.jar}" />
                <pathelement location="${build.dir}" />
                <pathelement location="${test.build.dir}" />
            </classpath>
        </java>
    </target>

    <target name="jar" depends="compile">
        <mkdir dir="${dist.dir}" />
        <jar destfile="${plugin.jar}" basedir="${build.dir}" />
        <echo message="Plugin gerado: ${plugin.jar}" />
    </target>
</project>
